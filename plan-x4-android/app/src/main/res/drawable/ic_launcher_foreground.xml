<!-- Simple "measured room corner" mark: two walls meeting at a corner, with a laser beam
     hitting the far wall — keeps the launcher icon on-theme without needing a raster asset. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:strokeColor="#F3F4EE"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M34,74 L34,34 L74,34" />
    <path
        android:strokeColor="@color/launcher_laser"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M34,74 L74,34" />
    <path
        android:fillColor="@color/launcher_laser"
        android:pathData="M71,31 L77,31 L77,37 L74,34 Z" />
</vector>
